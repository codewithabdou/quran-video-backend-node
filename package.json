{
    "name": "backend-node",
    "version": "1.0.2",
    "description": "Node.js backend for Quran Reels",
    "main": "src/server.js",
    "type": "module",
    "scripts": {
        "start": "node src/server.js",
        "dev": "nodemon src/server.js",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
        "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
        "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
        "env:dev": "copy .env.dev .env",
        "env:prod": "copy .env.prod .env",
        "download-data": "node src/scripts/downloadAssets.js"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.5.0",
        "@prisma/client": "^7.5.0",
        "axios": "^1.7.9",
        "bullmq": "^5.70.4",
        "canvas": "^3.0.1",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "express-rate-limit": "^8.2.1",
        "express-session": "^1.19.0",
        "express-validator": "^7.3.1",
        "ffmpeg-static": "^5.3.0",
        "ffprobe-static": "^3.1.0",
        "fluent-ffmpeg": "^2.1.3",
        "helmet": "^8.1.0",
        "ioredis": "^5.10.0",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.1.1",
        "nodemon": "^3.1.14",
        "passport": "^0.7.0",
        "passport-google-oauth20": "^2.0.0",
        "pexels": "^1.4.0",
        "pg": "^8.20.0",
        "prisma": "^7.5.0",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "tslib": "^2.8.1",
        "uuid": "^11.0.5",
        "web-push": "^3.6.7"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/pg": "^8.18.0",
        "jest": "^30.2.0",
        "supertest": "^7.1.4"
    }
}
