# Environment Configuration Template
# Copy this file to .env.dev or .env.prod and fill in the values

# Server Configuration
PORT=5000

# Security - CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Security - Trusted IPs (comma-separated)
# IMPORTANT: This is for infrastructure/testing IPs that bypass rate limiting
# NOT for regular users! Leave empty in production unless you need to whitelist
# specific servers (monitoring, CI/CD, your dev machine, etc.)
# Example: TRUSTED_IPS=203.0.113.45,198.51.100.22
TRUSTED_IPS=127.0.0.1,::1

# Pexels API (for background videos)
PEXELS_API_KEY=your_pexels_api_key_here

# Push Notifications - VAPID Keys
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_public_key_here
VAPID_PRIVATE_KEY=your_private_key_here
VAPID_EMAIL=mailto:your-email@example.com

# Redis (BullMQ queue)
REDIS_URL=redis://localhost:6379

# PostgreSQL Database
DATABASE_URL=postgresql://quran:quran_secret@localhost:5432/qurandb?schema=public

# Google OAuth 2.0
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# JWT Secret (generate a strong random string)
JWT_SECRET=your_jwt_secret_change_me_in_production

# Frontend URL (for OAuth redirect)
FRONTEND_URL=http://localhost:5173

# Environment
NODE_ENV=development
